{
  "name": "claude-code-search",
  "version": "1.2.2",
  "description": "Interactive TUI for searching Claude Code session history",
  "keywords": [
    "anthropic",
    "claude",
    "claude-code",
    "cli",
    "history",
    "prompt",
    "search",
    "terminal",
    "tui"
  ],
  "homepage": "https://github.com/mblode/claude-code-search#readme",
  "bugs": {
    "url": "https://github.com/mblode/claude-code-search/issues"
  },
  "license": "MIT",
  "author": "Matthew Blode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mblode/claude-code-search.git"
  },
  "bin": {
    "ccs": "dist/ccs.js"
  },
  "files": [
    "dist",
    "example.png"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "dev": "tsup --watch",
    "release": "npm run build && changeset publish",
    "start": "node dist/ccs.js",
    "prepare": "lefthook install || true",
    "lint": "ultracite check",
    "format": "ultracite fix",
    "check:types": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "clipboardy": "^5.3.1",
    "ink": "^7.1.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "tsup": "^8.5.1",
    "typescript": "7.0.2",
    "ultracite": "7.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
